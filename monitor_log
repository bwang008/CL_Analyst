#!/usr/bin/env bash
set -euo pipefail

read -r -p "Client ID: " client_id
if [[ -z "${client_id}" ]]; then
  echo "Client ID is required."
  exit 1
fi

log_file="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reports/livetrader_${client_id}.log"
if [[ ! -f "${log_file}" ]]; then
  echo "Log file not found: ${log_file}"
  exit 1
fi

tail -f "${log_file}"
