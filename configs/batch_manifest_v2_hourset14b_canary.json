{
  "_comment": "HourSet_14B CANARY - conforms to batch_manifest_v2_hourset14a_canary.json template (baseline format, optuna block, opt_mode=individual two-pass chain).",
  "infrastructure": {
    "machine_type": "c2-standard-16",
    "provisioning_model": "STANDARD",
    "timeout_minutes": 240,
    "max_concurrent_vcpus": 288,
    "vcpus_per_vm": 16,
    "max_concurrent_vms": 12
  },
  "baseline": {
    "symbol": "CL",
    "data_workflow": {
      "dataset_version": "HourSet_14B",
      "resolution": "1h",
      "output_dir": "data/processed",
      "features": {
        "windows": [24, 72, 168],
        "macro_windows": {"1W": 168}
      },
      "targets": {
        "raw_horizon": 120,
        "atr_period": 14,
        "definitions": [
          { "type": "triple_barrier", "tp_multiplier": 2.0, "sl_multiplier": 1.0, "horizon": 6 },
          { "type": "triple_barrier", "tp_multiplier": 3.0, "sl_multiplier": 1.0, "horizon": 6 }
        ]
      }
    },
    "training_workflow": {
      "train_cutoff_date": "2022-01-01",
      "holdout_cutoff_date": null,
      "target_columns": [],
      "gcs_base_dir": "gs://cltrainer-optuna-results/canary",
      "optuna": {
        "n_trials": 3,
        "metrics": ["logloss", "average_precision"],
        "max_depth_min": 3,
        "max_depth_max": 6,
        "num_leaves_min": 15,
        "num_leaves_max": 31,
        "max_n_estimators": 500,
        "early_stopping_rounds": 15,
        "max_folds": 3,
        "learning_rate_min": 0.005,
        "learning_rate_max": 0.02,
        "min_child_samples_min": 150,
        "min_child_samples_max": 400,
        "feature_fraction_min": 0.4,
        "feature_fraction_max": 0.8,
        "post_optimizer_trials": 3,
        "post_optimizer_holdout_months": 6
      }
    },
    "execution_workflow": {
      "slippage_per_side": 0.01,
      "opt_mode": "individual",
      "execution_data_path": "gs://cltrainer-optuna-results/data/CL_raw.parquet",
      "strategy_config_path": "configs/strategies/hourly_ensemble_010.json"
    }
  },
  "experiments": [
    {
      "label": "HS14B 2x1 6H",
      "gcs_prefix": "sweep_hs14b_2x1_6h_canary",
      "overrides": {
        "symbol": "CL",
        "training_workflow": {
          "target_columns": ["TARGET_TRIPLE_2x1_6H_LONG", "TARGET_TRIPLE_2x1_6H_SHORT"]
        }
      }
    },
    {
      "label": "HS14B 3x1 6H",
      "gcs_prefix": "sweep_hs14b_3x1_6h_canary",
      "overrides": {
        "symbol": "CL",
        "training_workflow": {
          "target_columns": ["TARGET_TRIPLE_3x1_6H_LONG", "TARGET_TRIPLE_3x1_6H_SHORT"]
        }
      }
    }
  ]
}
