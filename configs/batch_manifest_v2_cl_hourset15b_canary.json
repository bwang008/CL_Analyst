{
  "_comment": "HourSet_15B CANARY - pipeline-validation cut of batch_manifest_v2_hourset15b_scout.json, built on the batch_manifest_v2_hourset14b_canary.json template (canary optuna: 3 sweep trials / 3 post-opt trials, narrow LGBM box, gcs canary dir, opt_mode=individual two-pass chain). Same 15B dataset (CL_HourSet_15B.parquet); targets cut from the scout's 6 down to 2 (kept the two horizon-6 families 4x1_6H + 3x1_6H, both confirmed present in the parquet; 3x1_6H matches the 14B canary for cross-dataset comparability).",
  "infrastructure": {
    "machine_type": "n2-standard-32",
    "provisioning_model": "STANDARD",
    "timeout_minutes": 240,
    "max_concurrent_vcpus": 288,
    "vcpus_per_vm": 32,
    "max_concurrent_vms": 12
  },
  "baseline": {
    "symbol": "CL",
    "data_workflow": {
      "dataset_version": "HourSet_15B",
      "resolution": "1h",
      "output_dir": "data/processed",
      "features": {
        "windows": [24, 72, 168],
        "macro_windows": {"1W": 168}
      },
      "targets": {
        "raw_horizon": 120,
        "atr_period": 14,
        "definitions": [
          { "type": "triple_barrier", "tp_multiplier": 4.0, "sl_multiplier": 1.0, "horizon": 6 },
          { "type": "triple_barrier", "tp_multiplier": 3.0, "sl_multiplier": 1.0, "horizon": 6 }
        ]
      }
    },
    "training_workflow": {
      "train_cutoff_date": "2022-01-01",
      "holdout_cutoff_date": null,
      "target_columns": [],
      "gcs_base_dir": "gs://cltrainer-optuna-results/canary",
      "random_seed": 42,
      "optuna": {
        "n_trials": 3,
        "metrics": ["logloss", "average_precision"],
        "max_depth_min": 3,
        "max_depth_max": 6,
        "num_leaves_min": 15,
        "num_leaves_max": 31,
        "max_n_estimators": 500,
        "early_stopping_rounds": 15,
        "max_folds": 3,
        "learning_rate_min": 0.005,
        "learning_rate_max": 0.02,
        "min_child_samples_min": 150,
        "min_child_samples_max": 400,
        "feature_fraction_min": 0.4,
        "feature_fraction_max": 0.8,
        "post_optimizer_trials": 3,
        "post_optimizer_ensemble_trials": 0,
        "post_optimizer_holdout_months": 12
      }
    },
    "execution_workflow": {
      "slippage_per_side": 0.01,
      "opt_mode": "individual",
      "execution_data_path": "gs://cltrainer-optuna-results/data/CL_raw.parquet",
      "strategy_config_path": "configs/strategies/hourly_ensemble_010.json"
    }
  },
  "experiments": [
    {
      "label": "HS15B 4x1 6H",
      "gcs_prefix": "sweep_hs15b_4x1_6h_canary",
      "overrides": {
        "symbol": "CL",
        "training_workflow": {
          "target_columns": ["TARGET_TRIPLE_4x1_6H_LONG", "TARGET_TRIPLE_4x1_6H_SHORT"]
        }
      }
    },
    {
      "label": "HS15B 3x1 6H",
      "gcs_prefix": "sweep_hs15b_3x1_6h_canary",
      "overrides": {
        "symbol": "CL",
        "training_workflow": {
          "target_columns": ["TARGET_TRIPLE_3x1_6H_LONG", "TARGET_TRIPLE_3x1_6H_SHORT"]
        }
      }
    }
  ]
}
