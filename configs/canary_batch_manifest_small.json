{
  "infrastructure": {
    "max_concurrent_vms": 2,
    "max_concurrent_vcpus": 32,
    "vcpus_per_vm": 16,
    "machine_type": "c2-standard-16",
    "provisioning_model": "STANDARD",
    "timeout_minutes": 120,
    "post_optimizer_trials": 10
  },
  "base_config": {
    "symbol": "CL",
    "data_workflow": {
      "dataset_version": "HourSet_08",
      "resolution": "1h",
      "features": {
        "windows": [24, 72, 168],
        "macro_windows": {
          "1W": 168
        },
        "include_momentum": true,
        "include_macro": true,
        "include_extended": false,
        "include_dma": false,
        "include_ichimoku": false,
        "include_term_structure": false
      },
      "targets": {
        "raw_horizon": 120,
        "atr_period": 14,
        "definitions": [
          {
            "type": "triple_barrier",
            "tp_multiplier": 3.0,
            "sl_multiplier": 1.0,
            "horizon": 6
          }
        ]
      }
    },
    "training_workflow": {
      "train_cutoff_date": "2022-01-01",
      "holdout_cutoff_date": "2026-01-01",
      "target_columns": [
        "TARGET_TRIPLE_3x1_6H_LONG",
        "TARGET_TRIPLE_3x1_6H_SHORT"
      ],
      "gcs_base_dir": "gs://cltrainer-optuna-results/canary"
    },
    "execution_workflow": {
      "slippage_multiplier": 1.0,
      "strategy_config_path": "configs/strategies/hourly_ensemble_008_2.json"
    }
  },
  "experiments": [
    {
      "label": "Canary_Exp1",
      "gcs_prefix": "canary_exp1",
      "override_config": {
        "training_workflow": {
          "target_columns": [
            "TARGET_TRIPLE_3x1_6H_LONG",
            "TARGET_TRIPLE_3x1_6H_SHORT"
          ]
        }
      }
    },
    {
      "label": "Canary_Exp2",
      "gcs_prefix": "canary_exp2",
      "override_config": {
        "training_workflow": {
          "target_columns": [
            "TARGET_TRIPLE_3x1_12H_LONG",
            "TARGET_TRIPLE_3x1_12H_SHORT"
          ]
        }
      }
    }
  ]
}
