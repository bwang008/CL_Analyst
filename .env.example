 # Copy to .env and adjust for your environment.
 # This file is safe to commit; never commit .env with secrets.
 
 # Absolute path to the shared data root (must contain data/ and models/).
 # Example: /home/youruser/CL_Analyst_Data
 CL_DATA_ROOT=/path/to/CL_Analyst_Data
 
 # Optional: used to refresh FRED macro data for set_07/hourly models.
 # Leave blank if you do not want auto-refresh.
 FRED_API_KEY=

# Optional: default IBKR connection settings (CLI flags override).
IBKR_HOST=127.0.0.1
IBKR_PORT=4002

# Optional: Telegram alerts (see src/live_execution/utils/telegram_alert.py).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Databento API Key for downloading data (required by databento scripts)
DATABENTO_API_KEY=
