[Unit]
Description=CL Analyst Live Trader (hourly_ensemble_004)
Documentation=https://github.com/bwang/CL_Analyst_Development
After=ibc-gateway.service
Requires=ibc-gateway.service

[Service]
Type=simple
EnvironmentFile=/etc/cl-trader.env

# Activate venv and run the live trader
ExecStart=/opt/cl-trader/venv/bin/python -m src.live_execution.live_trader \
    --config configs/strategies/hourly_ensemble_004.json \
    --port 4002

WorkingDirectory=/opt/cl-trader/app

# Self-healing: restart on ANY failure (crash, OOM, etc.)
Restart=always
RestartSec=60
StartLimitIntervalSec=3600
StartLimitBurst=10

# Run as dedicated service user (not root)
User=cltrader
Group=cltrader

# Logging to journald (also logs to reports/livetrader_*.log)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=live-trader

# OOM protection: kill this service last (prefer to kill other things)
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
