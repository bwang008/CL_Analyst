# =============================================================================
# CL Analyst — Cloud VPS Environment File
# =============================================================================
# Copy to /etc/cl-trader.env and fill in your values.
# Permissions: chmod 600 /etc/cl-trader.env
# =============================================================================

# --- IBKR Credentials (use a READ-ONLY second user!) ---
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password
TRADING_MODE=paper

# --- IBC Configuration ---
# IB Gateway version (check https://www.interactivebrokers.com/en/trading/ibgateway-stable.php)
IBC_GATEWAY_VERSION=10.30

# --- Application Paths ---
CL_DATA_ROOT=/opt/cl-trader/data

# --- API Keys ---
FRED_API_KEY=your_fred_api_key

# --- Telegram Notifications ---
# 1. Create a bot via @BotFather → copy the token
# 2. Send any message to the bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id (look for "chat":{"id": XXXXXX})
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
