[Unit]
Description=IBC-managed IB Gateway (Headless via Xvfb)
Documentation=https://github.com/IbcAlpha/IBC
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/cl-trader.env

# IBC manages IB Gateway startup, 2FA, and daily restarts.
# Xvfb provides a virtual X display since IB Gateway requires X11 even headless.
ExecStartPre=/usr/bin/bash -c 'pgrep Xvfb || /usr/bin/Xvfb :1 -screen 0 1024x768x24 &'
ExecStart=/opt/ibc/scripts/ibcstart.sh \
    "${IBC_GATEWAY_VERSION}" \
    --gateway \
    --mode=${TRADING_MODE} \
    --user=${TWS_USERID} \
    --pw=${TWS_PASSWORD}

# Self-healing: restart on crash with exponential backoff
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=600
StartLimitBurst=10

# Environment for headless X11
Environment=DISPLAY=:1
Environment=JAVA_TOOL_OPTIONS=-Xmx512m

# Run as dedicated service user (not root)
User=cltrader
Group=cltrader

# Logging to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ibc-gateway

[Install]
WantedBy=multi-user.target
