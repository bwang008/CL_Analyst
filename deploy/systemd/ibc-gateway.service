[Unit]
Description=IBC-managed IB Gateway (Headless via Xvfb)
Documentation=https://github.com/IbcAlpha/IBC
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/cl-trader.env

# IBC manages IB Gateway startup, 2FA, and daily restarts.
# xvfb-run wraps the entire process with a virtual X display,
# auto-selecting an available display number and tying Xvfb
# lifecycle to this service (no orphaned Xvfb processes).
ExecStart=/usr/bin/xvfb-run --auto-servernum --server-args="-screen 0 1024x768x24" \
    /opt/ibc/scripts/ibcstart.sh \
    "${IBC_GATEWAY_VERSION}" \
    --gateway \
    --mode=${TRADING_MODE} \
    --user=${TWS_USERID} \
    --pw=${TWS_PASSWORD}

# Self-healing: restart on crash with exponential backoff
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=600
StartLimitBurst=10

# JVM memory limit for IB Gateway
Environment=JAVA_TOOL_OPTIONS=-Xmx512m

# Run as local user (not root)
User=bwang008
Group=bwang008

# Logging to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ibc-gateway

[Install]
WantedBy=multi-user.target
