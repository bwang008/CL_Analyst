/__pycache__
*.pyc
*.csv
*.parquet
*.json
*.yaml
*.yml
*.jsonl
*.jsonl.gz
*.jsonl.bz2
*.jsonl.xz
*.jsonl.lzma
*.jsonl.zstd
*.pkl
*.joblib
*.png
*.log
backtest_report*.txt
reports/

# ----- Keep these in git -----
# Model registry — keep ONLY lightweight configs/metadata (JSON + MD)
!models/registry/**/*.json
!models/registry/**/*.md
# Production — keep config + active model weights only
!models/production/config.json
!models/production/experiment_config.json
!models/production/final_model*.pkl
!models/production/feature_importance.csv
# Project config files
!experiments.json
!experiment_tracker.json
!research_backlog.json
!data/DATASETS.json
!.cursor/worktrees.json
# Strategy configs (JSON definitions for config-driven strategies)
!configs/*.json
!configs/strategies/**
configs/strategies/candidates/**

# ----- Disaster recovery: track prediction & artifact files -----
# Prediction CSVs used by backtest configs (typically < 3 MB each)
!data/predictions/*.csv
!data/predictions/*.csv.bak
# Pipeline artifact summaries (small text/JSON outputs)
!data/final_artifacts/**
!data/new_artifacts/**

# Runtime artifacts (live execution)
.env
*.zip
*.db
*.db-shm
*.db-wal
data/processed/warm_start_cache.parquet
reports/livetrader_13.log
# Temp files
%TEMP%/
tmp/

# Purged heavy artifacts
*.pdf
models/optuna_studies/
*final_model_pure.txt
pytest_out.txt
